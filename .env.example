# Copy to .env for local Vite. Never commit .env.
# Production: set the same VITE_* keys in Vercel.
# Native / OTA: optional overrides in public/config.js (window.__MINEOPS_CONFIG__).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — empty means payment-ready, not payment-live
VITE_STRIPE_PUBLISHABLE_KEY=

# Comma-separated emails for platform super-admin (Ty)
VITE_PLATFORM_ADMIN_EMAILS=

VITE_APP_VERSION=1.0.0
VITE_WEB_ORIGIN=https://mineops-ten.vercel.app

# Capgo public key — omit to disable JS OTA
VITE_CAPGO_KEY=
